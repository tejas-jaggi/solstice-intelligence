# Path to the EXISTING certified Customer Revenue Analytics DuckDB warehouse.
# The assistant is a read-only consumer; it never creates or modifies this file.
WAREHOUSE_PATH=./data/customer_revenue.duckdb

# Hosted LLM configuration (confirm model against your account at build time).
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Safety caps enforced by the validation gate and again at execution.
MAX_ROWS=1000
DEFAULT_LIMIT=100
