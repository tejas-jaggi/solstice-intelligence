# Path to the certified Customer Revenue Analytics DuckDB warehouse.
# The assistant is a read-only consumer; it never creates or modifies this file.
# Deployment default (repo-relative, bundled into the image):
WAREHOUSE_PATH=./data/solstice_apparel.duckdb
# For local development you may override this with an absolute path to the
# warehouse in the producer repository.

# Hosted LLM configuration.
OPENAI_API_KEY=sk-your-key-here
# Use a PINNED dated model snapshot for reproducible deployments — not a floating
# alias such as "gpt-4o". Confirm the exact snapshot against your account.
OPENAI_MODEL=gpt-4o-2024-08-06

# Safety caps enforced by the validation gate and again at execution.
MAX_ROWS=1000
DEFAULT_LIMIT=100

# --- Deployment Access Guard (ADR-012) -------------------------------------
# Protects OpenAI spend on a public demo. Defaults below leave it DISABLED
# (Development mode). A deployment enables the rate limiter, and optionally the
# Demo Access Gate.
#   RATE_LIMIT_MAX_REQUESTS=0  -> rate limiter disabled (local dev / tests)
#   RATE_LIMIT_MAX_REQUESTS=20 -> allow 20 requests per window (Demo mode)
RATE_LIMIT_MAX_REQUESTS=0
RATE_LIMIT_WINDOW_SECONDS=60
# Set SOLSTICE_DEMO_TOKEN to require a shared token on /v1/ask (Restricted demo).
# Leave unset to keep the gate disabled.
# SOLSTICE_DEMO_TOKEN=
